# 网页/应用配置（docker compose 会自动读取本文件，可按需改密码/超时）
# PostgreSQL 应用角色（最小权限，仅 demo_records 的读写）
PG_APP_USER=app
PG_APP_PASSWORD=apppass
PG_APP_DB=appdb

# 流复制角色（仅 REPLICATION，用于持续 WAL 流复制）
PG_REPL_USER=repl
PG_REPL_PASSWORD=replpass

# 数据库超级用户（建库建角色、ALTER SYSTEM、pg_promote、基础备份）
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=postgres-pass

# 切换参数
SWITCH_TIMEOUT=20          # 等待备库回放的超时秒数，超时自动回滚恢复旧主写入
POLL_INTERVAL=1            # 后台状态机轮询/唤醒间隔秒
PROMOTE_WAIT_SECONDS=30    # 等待 pg_promote 生效的上限秒数

# 网页对外端口
WEB_PORT=8000
